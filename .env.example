# OpenRouter (required for Q&A, summary) - Alternative to OpenAI with better free tier
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
# Available free models: meta-llama/llama-3.2-3b-instruct:free, meta-llama/llama-3.2-1b-instruct:free
# Paid models: anthropic/claude-3-haiku, openai/gpt-3.5-turbo, openai/gpt-4o-mini
# See all models at: https://openrouter.ai/models

# Offline mode - set to 'true' to show fallback messages when OpenRouter is unavailable
OFFLINE_MODE=false

# Firebase Admin — path to service account JSON (Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Firebase Web SDK — from Project settings → Your apps → Web app config
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=